#version 430 compatibility

// ---- ASCII options ----
#define ASCII_DENSITY 2 // [0 1 2 3 4]
#define ASCII_CHARSET 0 // [0 1 2 3 4 5 6 7]
#define ASCII_COLOR_MODE 0 // [0 1 2 3 4 5 6]
#define ASCII_BACKGROUND 0 // [0 1 2]
#define ASCII_BRIGHTNESS 1.0 // [0.5 0.75 1.0 1.25 1.5 2.0]
#define ASCII_CONTRAST 1.0 // [0.5 0.75 1.0 1.25 1.5 2.0]
#define ASCII_INVERT 0 // [0 1]
#define ASCII_SCANLINES 0 // [0 1]

#if ASCII_DENSITY == 0
#define ASCII_CELL_W 4
#define ASCII_CELL_H 8
#elif ASCII_DENSITY == 1
