#if ASCII_CHARSET == 0
#define ASCII_RAMP_LEN 95
const int asciiRamp[ASCII_RAMP_LEN] = { 0, 13, 14, 64, 7, 63, 12, 26, 2, 94, 11, 29, 1, 62, 27, 28, 82, 92, 15, 52, 30, 59, 60, 67, 76, 8, 10, 31, 90, 17, 41, 42, 73, 93, 9, 83, 84, 86, 57, 58, 74, 88, 23, 35, 44, 48, 69, 89, 19, 37, 75, 78, 79, 85, 91, 18, 21, 43, 66, 70, 80, 20, 38, 51, 65, 72, 54, 61, 22, 25, 33, 53, 56, 34, 39, 50, 40, 87, 24, 47, 68, 77, 81, 3, 36, 71, 4, 6, 16, 49, 55, 45, 46, 5, 32 };
#elif ASCII_CHARSET == 1
#define ASCII_RAMP_LEN 10
const int asciiRamp[ASCII_RAMP_LEN] = { 0, 13, 14, 26, 11, 29, 10, 3, 5, 32 };
#elif ASCII_CHARSET == 2
#define ASCII_RAMP_LEN 6
const int asciiRamp[ASCII_RAMP_LEN] = { 0, 13, 14, 26, 11, 29 };
#elif ASCII_CHARSET == 3
#define ASCII_RAMP_LEN 52
const int asciiRamp[ASCII_RAMP_LEN] = { 82, 52, 67, 76, 90, 41, 42, 73, 83, 84, 86, 57, 58, 74, 88, 35, 44, 48, 69, 89, 37, 75, 78, 79, 85, 43, 66, 70, 80, 38, 51, 65, 72, 54, 33, 53, 56, 34, 39, 50, 40, 87, 47, 68, 77, 81, 36, 71, 49, 55, 45, 46 };
#elif ASCII_CHARSET == 4
#define ASCII_RAMP_LEN 26
const int asciiRamp[ASCII_RAMP_LEN] = { 52, 41, 42, 57, 58, 35, 44, 48, 37, 43, 38, 51, 54, 33, 53, 56, 34, 39, 50, 40, 47, 36, 49, 55, 45, 46 };
#elif ASCII_CHARSET == 5
#define ASCII_RAMP_LEN 26
const int asciiRamp[ASCII_RAMP_LEN] = { 82, 67, 76, 90, 73, 83, 84, 86, 74, 88, 69, 89, 75, 78, 79, 85, 66, 70, 80, 65, 72, 87, 68, 77, 81, 71 };
#elif ASCII_CHARSET == 6
#define ASCII_RAMP_LEN 10
const int asciiRamp[ASCII_RAMP_LEN] = { 17, 23, 19, 18, 21, 20, 22, 25, 24, 16 };
#elif ASCII_CHARSET == 7
#define ASCII_RAMP_LEN 23
const int asciiRamp[ASCII_RAMP_LEN] = { 0, 67, 17, 23, 35, 69, 19, 37, 18, 21, 66, 70, 20, 38, 65, 22, 25, 33, 34, 24, 68, 36, 16 };
#else
#define ASCII_RAMP_LEN 95
const int asciiRamp[ASCII_RAMP_LEN] = { 0, 13, 14, 64, 7, 63, 12, 26, 2, 94, 11, 29, 1, 62, 27, 28, 82, 92, 15, 52, 30, 59, 60, 67, 76, 8, 10, 31, 90, 17, 41, 42, 73, 93, 9, 83, 84, 86, 57, 58, 74, 88, 23, 35, 44, 48, 69, 89, 19, 37, 75, 78, 79, 85, 91, 18, 21, 43, 66, 70, 80, 20, 38, 51, 65, 72, 54, 61, 22, 25, 33, 53, 56, 34, 39, 50, 40, 87, 24, 47, 68, 77, 81, 3, 36, 71, 4, 6, 16, 49, 55, 45, 46, 5, 32 };
#endif

void main() {
    vec2 res = vec2(viewWidth, viewHeight);
    vec2 fc = gl_FragCoord.xy;
    float cw = float(ASCII_CELL_W);
    float ch = float(ASCII_CELL_H);

    vec2 cellCoord = floor(fc / vec2(cw, ch));
    vec2 cellCenter = (cellCoord + 0.5) * vec2(cw, ch);
    vec2 cellUV = cellCenter / res;
    vec3 src = texture(colortex0, cellUV).rgb;

    // brightness/contrast on source
    src = (src - 0.5) * ASCII_CONTRAST + 0.5;
    src = clamp(src * ASCII_BRIGHTNESS, 0.0, 1.0);

    float lum = dot(src, vec3(0.299, 0.587, 0.114));
    lum = clamp(lum, 0.0, 1.0);
    int ri = int(lum * float(ASCII_RAMP_LEN - 1) + 0.5);
    int ci = asciiRamp[ri];

    int localX = int(mod(fc.x, cw));
    int localY = int(mod(fc.y, ch));

    // map to base font resolution
    int baseX = localX * ASCII_BASE_W / ASCII_CELL_W;
    int baseY = localY * ASCII_BASE_H / ASCII_CELL_H;
    if (baseX >= ASCII_BASE_W) baseX = ASCII_BASE_W - 1;
    if (baseY >= ASCII_BASE_H) baseY = ASCII_BASE_H - 1;

    int row = ASCII_BASE_H - 1 - baseY;
    uint bits = asciiFont[ci][row];
    int bitVal = int((bits >> (ASCII_BASE_W - 1 - baseX)) & 1u);

    // glyph color by mode
    vec3 glyphColor = src;
    if (ASCII_COLOR_MODE == 1) {
        glyphColor = vec3(lum);
    } else if (ASCII_COLOR_MODE == 2) {
        glyphColor = vec3(0.1, 1.0, 0.3) * lum;
    } else if (ASCII_COLOR_MODE == 3) {
        glyphColor = mix(vec3(0.2, 0.1, 0.0), vec3(1.0, 0.7, 0.3), lum);
    } else if (ASCII_COLOR_MODE == 4) {
        glyphColor = mix(vec3(0.0, 0.1, 0.2), vec3(0.3, 0.8, 1.0), lum);
    } else if (ASCII_COLOR_MODE == 5) {
        glyphColor = vec3(1.0) - src;
    } else if (ASCII_COLOR_MODE == 6) {
        float g = (src.r * 0.393 + src.g * 0.769 + src.b * 0.189);
        float b = (src.r * 0.349 + src.g * 0.686 + src.b * 0.168);
        float r = (src.r * 0.272 + src.g * 0.534 + src.b * 0.131);
        glyphColor = vec3(r, g, b);
    }

    // background
    vec3 bg = vec3(0.0);
    if (ASCII_BACKGROUND == 1) {
        bg = src * 0.06;
    } else if (ASCII_BACKGROUND == 2) {
        bg = src;
    }

    vec3 fg = glyphColor;
    if (ASCII_INVERT == 1) {
        vec3 tmp = fg;
        fg = bg;
        bg = tmp;
    }

    vec3 outColor = (bitVal == 1) ? fg : bg;

    if (ASCII_SCANLINES == 1) {
        float line = 0.85 + 0.15 * step(0.5, fract(fc.y * 0.5));
        outColor *= line;
    }

    outColor.rgb = clamp(outColor.rgb, 0.0, 1.0);
    outColor.rgb = pow(outColor.rgb, vec3(1.0 / 2.2));
    color = vec4(outColor, 1.0);
}
