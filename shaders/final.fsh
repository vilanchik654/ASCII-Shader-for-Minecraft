#define ASCII_CELL_H 20
#else
#define ASCII_CELL_W 12
#define ASCII_CELL_H 24
#endif

#define ASCII_BASE_W 8
#define ASCII_BASE_H 16

uniform sampler2D colortex0;
uniform float viewWidth;
uniform float viewHeight;

in vec2 texcoord;

layout(location = 0) out vec4 color;

